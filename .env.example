# Credentials S3 OVH (utilisateur Object Storage)
OVH_ACCESS_KEY=votre_access_key
OVH_SECRET_KEY=votre_secret_key

# Conteneur créé dans le manager
OVH_BUCKET=asclepios

# Région / endpoint Paris 3-AZ
OVH_REGION=eu-west-par
OVH_ENDPOINT=https://s3.eu-west-par.io.cloud.ovh.net

# Préfixe distant (dossier logique dans le bucket)
OVH_PREFIX=vault

# Clé de chiffrement Fernet (ne pas régénérer si des fichiers existent déjà sur OVH)
ENCRYPTION_KEY=

# Dossier local unique (source du push, destination du pull)
LOCAL_DATA_DIR=vault

# Clé API Cursor (pour la génération de rapports IA)
CURSOR_API_KEY=cursor_...

# Google Agenda « Médical » — ADRESSE SECRÈTE au format iCal (lecture seule).
# Google Agenda → Paramètres du calendrier → « Intégrer l'agenda »
#   → « Adresse secrète au format iCal ».
# Utiliser l'adresse SECRÈTE et non l'URL publique : le calendrier reste privé.
# Ce secret ne quitte jamais le backend (le frontend passe par /api/agenda/*).
MEDICAL_ICAL_URL=https://calendar.google.com/calendar/ical/.../private-.../basic.ics

# --- Auth mono-utilisateur + TOTP (obligatoire avant exposition Internet / VPS) ---
# Mot de passe hashé :
#   docker compose exec -it api python scripts/hash_password.py
# Secret TOTP + QR Google Authenticator (Dev et Prod = 2 secrets / 2 QR) :
#   docker compose exec -it api python scripts/setup_totp.py --env development
#   docker compose exec -it api python scripts/setup_totp.py --env production
#
# Fichier chargé : .env (dev) ou .env.prod (prod)
#   ASCLEPIOS_ENV_FILE=.env.prod docker compose up -d
ASCLEPIOS_ENV=development
# ASCLEPIOS_ENV_FILE=.env
AUTH_PASSWORD_HASH=
AUTH_TOTP_SECRET=
AUTH_TOTP_ISSUER=Asclepios
SESSION_SECRET=
# Durée de session en secondes (défaut 14 jours)
# SESSION_MAX_AGE=1209600
# Preauth TOTP (secondes, défaut 5 min)
# PREAUTH_MAX_AGE=300
# Origines autorisées (cookies credentials)
# Dev :
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Prod (exemple) :
# CORS_ORIGINS=https://asclepios.masia-antoine.fr
# Cookie Secure (HTTPS) — obligatoire en prod derrière TLS
# AUTH_COOKIE_SECURE=true
# ASCLEPIOS_ENV=production

# --- Déploiement VPS (local Mac uniquement — dans .env, PAS .env.prod) ---
# Préférer une clé SSH : ssh-copy-id ubuntu@51.38.236.129
DEPLOY_SSH_HOST=51.38.236.129
DEPLOY_SSH_USER=ubuntu
DEPLOY_SSH_PATH=~/asclepios
# Optionnel si pas de clé SSH (nécessite sshpass) :
# DEPLOY_SSH_PASSWORD=
