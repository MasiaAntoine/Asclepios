# Credentials S3 OVH (utilisateur Object Storage)
OVH_ACCESS_KEY=votre_access_key
OVH_SECRET_KEY=votre_secret_key

# Conteneur créé dans le manager
OVH_BUCKET=medical-perso

# Région / endpoint Paris 3-AZ
OVH_REGION=eu-west-par
OVH_ENDPOINT=https://s3.eu-west-par.io.cloud.ovh.net

# Préfixe distant (dossier logique dans le bucket)
OVH_PREFIX=vault

# Clé de chiffrement Fernet (ne pas régénérer si des fichiers existent déjà sur OVH)
ENCRYPTION_KEY=

# Dossier local unique (source du push, destination du pull)
LOCAL_DATA_DIR=data
